const sky = document.getElementById("sky");
const cursor = document.getElementById("cursor");

// clouds
for (let i = 0; i < 6; i++) {
  const cloud = document.createElement("div");
  cloud.className = "cloud";
  const width = 120 + Math.random() * 180;
  cloud.style.width = width + "px";
  cloud.style.height = width * 0.3 + "px";
  cloud.style.top = Math.random() * 70 + "%";
  cloud.style.animationDuration = 50 + Math.random() * 50 + "s";
  cloud.style.animationDelay = -Math.random() * 80 + "s";
  cloud.style.opacity = 0.5 + Math.random() * 0.4;
  sky.appendChild(cloud);
}

// butterflies
const bugs = ["🦋", "🦋", "🦋", "🌸", "✨"];
for (let i = 0; i < 9; i++) {
  const b = document.createElement("div");
  b.className = "butterfly";
  const inner = document.createElement("span");
  inner.textContent = bugs[Math.floor(Math.random() * bugs.length)];
  inner.style.fontSize = 22 + Math.random() * 22 + "px";
  inner.style.animationDuration = 2 + Math.random() * 3 + "s";
  b.appendChild(inner);
  b.style.top = 5 + Math.random() * 80 + "%";
  b.style.animationDuration = 18 + Math.random() * 20 + "s";
  b.style.animationDelay = -Math.random() * 30 + "s";
  sky.appendChild(b);
}

// butterfly cursor
document.addEventListener("mousemove", function (e) {
  cursor.style.left = e.clientX + "px";
  cursor.style.top = e.clientY + "px";
});

// sparkle burst on click
document.addEventListener("click", function (e) {
  cursor.classList.add("big");
  setTimeout(function () {
    cursor.classList.remove("big");
  }, 200);

  const items = ["🦋", "✨", "💖", "🌸"];
  for (let i = 0; i < 8; i++) {
    const s = document.createElement("div");
    s.className = "sparkle";
    s.textContent = items[Math.floor(Math.random() * items.length)];
    s.style.left = e.clientX + "px";
    s.style.top = e.clientY + "px";
    const angle = (Math.PI * 2 * i) / 8;
    const dist = 50 + Math.random() * 40;
    s.style.setProperty("--x", Math.cos(angle) * dist + "px");
    s.style.setProperty("--y", Math.sin(angle) * dist + "px");
    document.body.appendChild(s);
    setTimeout(function () {
      s.remove();
    }, 900);
  }
});